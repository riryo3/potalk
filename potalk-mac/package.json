{
  "name": "potalker-electron",
  "version": "0.2.1",
  "description": "Potalker（ぽっと通話 非公式クライアント）Electron 版",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . Potalker --platform=darwin --arch=arm64,x64 --icon=icon.icns --ignore=^/dist --out=dist --overwrite --extend-info=info.plist",
    "dist:win": "electron-builder --win nsis zip --x64 --publish never"
  },
  "keywords": [],
  "author": "riryo3",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "productName": "Potalker",
  "build": {
    "appId": "app.potalker.win",
    "productName": "Potalker",
    "copyright": "ぽっと通話（potalk.app）の非公式クライアントです。サイトの作者とは関係ありません。",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "chat-preload.js",
      "room-preload.js",
      "shell-preload.js",
      "patch-page.js",
      "*.html",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
